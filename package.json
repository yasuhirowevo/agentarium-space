{
  "name": "agentarium-space",
  "productName": "Agentarium Space",
  "version": "0.1.0",
  "description": "Agentarium Space, a local-only visualizer for Claude Code / Codex CLI sessions",
  "author": "yasuhirowevo",
  "repository": {
    "type": "git",
    "url": "https://github.com/yasuhirowevo/agentarium-space.git"
  },
  "homepage": "https://github.com/yasuhirowevo/agentarium-space#readme",
  "bugs": {
    "url": "https://github.com/yasuhirowevo/agentarium-space/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "node src/server.js",
    "scan": "node src/scan.js",
    "test": "node --test",
    "package:mac": "electron-builder --mac dir --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false -c.mac.forceCodeSigning=false",
    "dist:mac": "electron-builder --mac zip --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false -c.mac.forceCodeSigning=false",
    "dist:mac:signed": "node scripts/build-macos-signed.mjs",
    "package:win": "electron-builder --win dir --x64 --publish never",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "smoke:package": "node scripts/smoke-packaged.mjs",
    "smoke:package:win": "node scripts/smoke-packaged-windows.mjs",
    "smoke:portable:win": "pwsh -NoProfile -File scripts/smoke-portable-windows.ps1"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "26.15.3"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
